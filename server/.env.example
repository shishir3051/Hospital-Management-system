# Server Configuration
NODE_ENV=development
PORT=3001

# Database (MongoDB connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthcare-hms?retryWrites=true&w=majority

# Security (use a strong random 32+ character string)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# Allowed Frontend Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Financial Configuration (decimal tax rate, e.g. 0.08 = 8%)
TAX_RATE=0.08

# SMTP Email Configuration (optional in development - falls back to Ethereal/console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="HealthCore Medical Center" <no-reply@healthcore.org>
